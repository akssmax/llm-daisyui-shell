{
  "id": "editorial-swiss",
  "category": "editorial-poster",
  "archetype": "minimal-swiss",
  "styleTags": [
    "editorial",
    "swiss",
    "grid"
  ],
  "density": "low",
  "hierarchy": "balanced",
  "regions": [
    {
      "id": "headline",
      "role": "headline",
      "relativeRect": {
        "x": 0,
        "y": 0.15,
        "w": 0.5,
        "h": 0.25
      },
      "alignment": "left",
      "importance": "primary"
    },
    {
      "id": "body",
      "role": "body",
      "relativeRect": {
        "x": 0,
        "y": 0.45,
        "w": 0.417,
        "h": 0.35
      },
      "alignment": "left",
      "importance": "secondary"
    },
    {
      "id": "meta",
      "role": "footer",
      "relativeRect": {
        "x": 0.667,
        "y": 0.15,
        "w": 0.333,
        "h": 0.2
      },
      "alignment": "right",
      "importance": "tertiary"
    }
  ],
  "supportedAspects": [
    {
      "w": 1080,
      "h": 1080
    }
  ],
  "grid": {
    "columns": 12,
    "safeMargin": 64
  },
  "constraints": {
    "regions": {
      "headline": {
        "maxLines": 3,
        "maxChars": 72,
        "preferredLineCount": 2,
        "minFontScale": "h2",
        "maxFontScale": "hero",
        "visualWeight": 0.667
      },
      "body": {
        "maxLines": 4,
        "maxChars": 160,
        "preferredLineCount": 3,
        "minFontScale": "caption",
        "maxFontScale": "body",
        "visualWeight": 0.25
      },
      "meta": {
        "maxLines": 1,
        "maxChars": 60,
        "preferredLineCount": 1,
        "minFontScale": "caption",
        "maxFontScale": "caption",
        "visualWeight": 0.083,
        "minDistanceFromEdge": 48
      }
    }
  },
  "reference": {
    "source": "manual",
    "archetype": "minimal-swiss",
    "tags": [
      "editorial",
      "swiss",
      "grid"
    ]
  }
}